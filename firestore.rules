rules_version = '2';

// Real per-user authorization: every client signs in with their own Google account (see
// src/lib/firebase.ts, signInWithGoogle) — anonymous auth is gone. Workspace membership is
// looked up by a deterministic doc ID (workspaceId + lowercased email, built by
// src/data/firestoreRepository.ts's membershipDocId) so a plain exists() check can answer
// "is this signed-in email a member of this workspace" without an indexed query.
//
// Known simplification (tracked in PROGRESS.md, not done here): `workspaceMembers` itself only
// requires being signed in, not already being a member — tightening that to "can only write
// your own membership, or extend one if you're already an owner/admin" is real per-row ACL
// logic and a bigger change. `workspaces`/`projects`/`boards`/`users`/`shareLinks`/
// `calendarConnections` are also just "any signed-in user" for the same reason: boards/projects
// don't carry a workspaceId field to check against directly. `tickets`/`goals`/`notifications`
// (the collections people actually read/write while using a workspace) get the real
// membership check below, which is the part that matters most for genuine multi-user use.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && exists(
        /databases/$(database)/documents/workspaceMembers/$(workspaceId + '__' + request.auth.token.email.lower())
      );
    }

    match /tickets/{ticketId} {
      allow read, update, delete: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
    }

    match /goals/{goalId} {
      allow read, update, delete: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
